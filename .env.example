# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요. (.env.local 은 git 에 올라가지 않습니다)

# Neon Postgres 연결 문자열 (Vercel → Storage → Neon 을 연결하면 자동으로 들어옵니다)
# 로컬에서는 Neon 콘솔의 Connection string(pooled) 또는 `vercel env pull .env.local` 로 받으세요.
# 서버에서만 쓰는 비밀 값입니다. 채팅/깃에 노출하지 마세요.
DATABASE_URL=

# ADMIN 화면 비밀번호. 비워 두면 기본값(1234)이라 인터넷 배포 시 반드시 바꾸세요.
ADMIN_PASSWORD=

# (선택) 부모 로그인 쿠키 서명 키. 길고 무작위인 값을 쓰세요. 비우면 ADMIN_PASSWORD 와 DATABASE_URL 에서 만듭니다.
AUTH_SECRET=
